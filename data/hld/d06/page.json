    "html": "\n        <div class=\"hero-meta\">\n          <span class=\"level-badge\" data-level=\"4\">Level 4 - Advanced</span>\n          <span class=\"time\">40 min</span>\n          <span class=\"chip company\">Uber</span>\n          <span class=\"chip company\">Amazon</span>\n          <span class=\"chip company\">Google</span>\n          <span class=\"chip company\">Microsoft</span>\n          <span class=\"chip company\">Flipkart</span>\n          <span class=\"chip kafka\">Kafka</span>\n        </div>\n        <h1>Ride Hailing (Uber/Ola)</h1>\n        <p class=\"lead\">Learn how an app finds the right car among a million moving ones in a few seconds, why driver locations never touch the main database, how one driver is never given two riders, and how to drive this classic design for 45 minutes with real numbers.</p>\n      "
