    "html": "\n        <div class=\"hero-meta\">\n          <span class=\"level-badge\" data-level=\"4\">Level 4 - Advanced</span>\n          <span class=\"time\">35 min</span>\n          <span class=\"chip accent\">HLD design</span>\n          <span class=\"chip company\">Google</span><span class=\"chip company\">Microsoft</span><span class=\"chip company\">Amazon</span><span class=\"chip company\">Flipkart</span>\n        </div>\n        <h1>Video Upload &amp; Transcoding (YouTube)</h1>\n        <p class=\"lead\">Learn how a 4 GB phone video becomes a smooth stream that plays on a slow train and on a 4K TV. You will design resumable uploads, a parallel transcoding pipeline, adaptive streaming and the metadata store well enough to drive a 45-minute interview.</p>\n      "
