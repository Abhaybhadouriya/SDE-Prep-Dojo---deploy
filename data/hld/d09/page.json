    "html": "\n        <div class=\"hero-meta\">\n          <span class=\"level-badge\" data-level=\"5\">Level 5 - Interview-ready</span>\n          <span class=\"time\">40 min</span>\n          <span class=\"chip accent\">HLD design</span>\n          <span class=\"chip company\">Flipkart</span><span class=\"chip company\">Amazon</span><span class=\"chip company\">Walmart</span><span class=\"chip company\">Meesho</span><span class=\"chip company\">Myntra</span>\n        </div>\n        <h1>Flash Sale (Flipkart Big Billion Days)</h1>\n        <p class=\"lead\">Learn how to sell 10,000 phones to the first lucky buyers out of millions who all press \"Buy\" at 12:00:00, without selling the 10,001st phone, without melting the database, and without taking the rest of the shop down with it.</p>\n      "
